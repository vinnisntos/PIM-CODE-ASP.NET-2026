@page
@model PIM2026.Pages.Cliente.HistoricoModel
@{
    ViewData["Title"] = "Meus Agendamentos - Studio Beauty";
}

<div class="container-cliente py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Meus Agendamentos</h2>
        <a href="/Cliente/Agendar" class="btn btn-primary">Novo Agendamento</a>
    </div>

    <!-- Agendamentos Futuros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Agendamentos Futuros</h5>
        </div>
        <div class="card-body">
            @if (Model.AgendamentosFuturos.Any())
            {
                <div class="row">
                    @foreach (var agendamento in Model.AgendamentosFuturos)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card border-@(agendamento.Status == "Confirmado" ? "success" : "warning")">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="card-title mb-1">@agendamento.Servico.Nome</h5>
                                            <span class="badge bg-@(agendamento.Status == "Confirmado" ? "success" : "warning")">
                                                @agendamento.Status
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-muted small">Código</div>
                                            <div class="fw-bold" style="font-family: monospace;">@agendamento.CodigoConfirmacao</div>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="text-muted small">Data</div>
                                            <div>@agendamento.DataHora.ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted small">Horário</div>
                                            <div>@agendamento.DataHora.ToString("HH:mm") - @agendamento.DataHoraFim.ToString("HH:mm")</div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(agendamento.Observacoes))
                                    {
                                        <hr />
                                        <div class="text-muted small">
                                            <strong>Observações:</strong> @agendamento.Observacoes
                                        </div>
                                    }

                                    @if ((agendamento.DataHora - DateTime.Now).TotalHours >= 24)
                                    {
                                        <hr />
                                        <form method="post" asp-page-handler="Cancelar" asp-route-id="@agendamento.Id"
                                              onsubmit="return confirm('Tem certeza que deseja cancelar este agendamento?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancelar Agendamento</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-3">Você não tem agendamentos futuros.</p>
                    <a href="/Cliente/Agendar" class="btn btn-primary">Fazer um Agendamento</a>
                </div>
            }
        </div>
    </div>

    <!-- Histórico -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Histórico</h5>
        </div>
        <div class="card-body">
            @if (Model.AgendamentosPassados.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Serviço</th>
                                <th>Data/Hora</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agendamento in Model.AgendamentosPassados)
                            {
                                <tr class="@(agendamento.Status == "Cancelado" ? "table-danger" : "")">
                                    <td>@agendamento.Servico.Nome</td>
                                    <td>@agendamento.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-@(agendamento.Status == "Concluído" ? "info" : agendamento.Status == "Cancelado" ? "secondary" : "success")">
                                            @agendamento.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">Nenhum histórico de agendamentos.</p>
            }
        </div>
    </div>
</div>
