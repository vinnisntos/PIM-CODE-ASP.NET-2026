@using PIM2026.Services
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Studio Beauty</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (AuthHelper.IsAuthenticated(HttpContextAccessor.HttpContext!))
    {
        @* Layout para usuários logados *@
        @if (AuthHelper.IsProfissional(HttpContextAccessor.HttpContext!))
        {
            @* Menu para Profissional *@
            <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #72243E, #C4486E);">
                <div class="container">
                    <a class="navbar-brand font-serif" href="/Profissional/Dashboard">Studio Beauty</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/Profissional/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Profissional/Servicos">Serviços</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    @AuthHelper.GetUsuarioNome(HttpContextAccessor.HttpContext!)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Logout">Sair</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }
        else
        {
            @* Menu para Cliente *@
            <nav class="navbar navbar-expand-lg" style="background: var(--cream); border-bottom: 1px solid var(--border);">
                <div class="container">
                    <a class="navbar-brand font-serif" href="/Cliente/Agendar" style="color: var(--dark);">Studio Beauty</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/Cliente/Agendar" style="color: var(--dark);">Agendar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Cliente/Historico" style="color: var(--dark);">Meus Agendamentos</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" style="color: var(--dark);">
                                    Olá, @AuthHelper.GetUsuarioNome(HttpContextAccessor.HttpContext!)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Logout">Sair</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }
    }

    <div class="app-shell">
        @RenderBody()
    </div>

    @if (AuthHelper.IsAuthenticated(HttpContextAccessor.HttpContext!))
    {
        @* Bottom nav para mobile *@
        <nav class="bottom-nav d-lg-none" id="bottomNav">
            @if (AuthHelper.IsProfissional(HttpContextAccessor.HttpContext!))
            {
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Profissional/Dashboard") ? "active" : "")" href="/Profissional/Dashboard">
                    <div class="nav-icon">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    </div>
                    <span class="nav-label">Dashboard</span>
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Profissional/Servicos") ? "active" : "")" href="/Profissional/Servicos">
                    <div class="nav-icon">
                        <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    </div>
                    <span class="nav-label">Serviços</span>
                </a>
            }
            else
            {
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Cliente/Agendar") ? "active" : "")" href="/Cliente/Agendar">
                    <div class="nav-icon">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    </div>
                    <span class="nav-label">Agendar</span>
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Cliente/Historico") ? "active" : "")" href="/Cliente/Historico">
                    <div class="nav-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 2v10h10"/><path d="M21.5 7.5l-7 7"/><path d="M14.5 14.5l-3 3"/></svg>
                    </div>
                    <span class="nav-label">Meus</span>
                </a>
            }
            <a class="nav-item" href="/Logout">
                <div class="nav-icon">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <span class="nav-label">Sair</span>
            </a>
        </nav>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
